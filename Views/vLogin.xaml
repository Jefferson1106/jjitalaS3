<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jjitalaS3.Views.vLogin"
             Title="vLogin">
    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label 
            Text="INICIO DE SESIÓN"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!--IMAGENES-->
        <!--1. Enlace web(jpg, png)
        2. Archivo jpg - png detro de los recursos-->

        <Image Source="login.jpg"
       WidthRequest="150"></Image>

        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>

        <Label Text="Usuario:"
               FontSize="18"
               Grid.Row="1"
               Grid.Column="0"/>
        <Entry x:Name="txtUsuario"
               Placeholder="Ingresa el usuario"
               Grid.Row="0"
            Grid.Column="1"/>

        <Label Text="Contraseña:"
                FontSize="18"
                Grid.Row="1"
                Grid.Column="0" />

        <Entry x:Name="txtcontrasena"
                Placeholder="Ingresa la contraseña"
                IsPassword="True"
                Grid.Row="1"
                Grid.Column="1" />

        <Button x:Name="btnIniciarSesion"
                Text="Iniciar sesiín"
                Clicked="btnIniciarSesion_Clicked"
                Grid.Row="2"
                Grid.Column="0"/>
        
        <Button x:Name="btnRegistrarUsuario"
                Text="RegistrarUsuario"
                Clicked="btnRegistrarUsuario_Clicked"
                Grid.Row="2"
                Grid.Column="2"/>
                

    </VerticalStackLayout>
</ContentPage>
