<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jjitalaS3.Views.vLogin"
             Title="vLogin">

    <ContentPage.Resources>

        <Style x:Key="styleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BackgroundColor" Value="DarkViolet"/>
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="Blue"/>
        </Style>

    </ContentPage.Resources>

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label 
            Text="INICIO DE SESIÓN"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!--IMAGENES-->
        <!--1. Enlace web(jpg, png)
        2. Archivo jpg - png detro de los recursos-->

        <Image Source="login.jpg"
       WidthRequest="150"></Image>

        <Grid 
              RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Text="Usuario:"
                  Style="{StaticResource styleLabel}"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Entry x:Name="txtUsuario"
                   Placeholder="Ingresa el usuario"
                   Grid.Row="0"
                   Grid.Column="1"/>


            <Label Text="Contraseña:"
                   Style="{StaticResource styleLabel}"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Entry x:Name="txtcontrasena"
                   Placeholder="Ingresa la contraseña"
                   IsPassword="True"
                   Grid.Row="1"
                   Grid.Column="1"/>
            <Button x:Name="btnIniciarSesion"
                    Text="Iniciar sesión"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>
            <Button x:Name="btnRegistrarUsuario"
                    Text="Registrar Usuario"
                    Clicked="btnRegistrarUsuario_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>

        </Grid>
                

    </VerticalStackLayout>
</ContentPage>
